# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Security & CORS
ALLOWED_ORIGINS=*

# Cache & Polling Configuration (Seconds)
CACHE_TTL_SECONDS=30
FETCH_INTERVAL_SECONDS=60

# Alpaca Market Data Fallback Keys
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY_HERE

# Cloudflare Worker Edge Proxy URL for Yahoo Finance
YAHOO_PROXY_URL=https://stock-market-worker.hacmehmet0117.workers.dev
